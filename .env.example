# ==============================================================================
# Silver Springs Care - Environment Configuration (.env)
# 
# INSTRUCTIONS:
# 1. Copy this file to `.env` in the root of your project:
#    cp .env.example .env
# 2. Modify any values below to match your environment.
# 3. `.env` is ignored by Git, ensuring secrets and database passwords
#    are NEVER pushed to GitHub or overwritten during cPanel deployments.
# ==============================================================================

# Application Environment ('development' or 'production')
APP_ENV=production

# Base URL (Leave commented out to auto-detect, or set explicitly)
# BASE_URL=https://silverspringscare.com.au

# Australian Business & Organization Details
APP_ABN="XX XXX XXX XXX"
SITE_PHONE="1300 772 273"
SITE_PHONE_RAW="1300772273"
SITE_EMAIL="hello@silverspringscare.com.au"
SITE_REFERRAL_EMAIL="referrals@silverspringscare.com.au"

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Choose 'sqlite' (zero-config, portable) or 'mysql' (cPanel MySQL / MariaDB)
DB_DRIVER=sqlite

# SQLite Storage Path (Relative to project root or absolute path)
DB_SQLITE_PATH="data/silversprings.sqlite"

# MySQL Credentials (Only used when DB_DRIVER=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_silversprings
DB_USER=cpaneluser_dbuser
DB_PASS="YourSecureDatabasePasswordHere"

# ------------------------------------------------------------------------------
# Staff Administration Portal (/admin/)
# ------------------------------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASS="SilverSprings2026!"

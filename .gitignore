# ==============================================================================
# Silver Springs Care - Git Ignore Rules
# ==============================================================================

# Environment & Local Configuration Overrides
config.local.php
includes/config.local.php
*.local.php
.env
.env.*
!.env.example
.env.local

# Database Files (Local SQLite databases must not be tracked or committed)
data/*.sqlite
data/*.sqlite3
data/*.db
data/*.sqlite-journal
data/*.sqlite-wal
data/*.sqlite-shm
data/backups/
*.sqlite
*.sqlite3
*.db
!data/.htaccess
!data/.gitkeep

# Temporary & Testing Artifacts
tests/test_cookie.txt
tests/test_*_cookie.txt
*.log
temp/
tmp/
cache/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE, Editor & Tooling Files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
